# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Caches and dataset artifacts
Data/cache/
Data/*_preprocessing/
data/cache/
data/*_preprocessing/
.cometml-runs/
*.cache

# Model Weights and Checkpoints (Use Google Drive / download scripts to manage weights)
*.pth
*.pt
*.joblib
*.pkl
models/*.pth
models/*.joblib
models/*.pt

# Generated prediction output files and plots
outputs/*.csv
plots/
results_rssi_*/
*.csv
!Data/*.csv
!data/*.csv

# Logs
*.log
log.txt

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Environment / IDE
.vscode/
.idea/
.venv/
env/
venv/

# Fine-tuning artifacts (large; kept local only)
scripts/finetune/cache/
scripts/finetune/checkpoints/
scripts/finetune/outputs/
scripts/fine-tuned-models/cache/
scripts/fine-tuned-models/checkpoints/
scripts/fine-tuned-models/outputs/
*.npy

# Split fine-tuning folders: caches / checkpoints / outputs / per-level runs stay local
scripts/finetune_*/cache*/
scripts/finetune_*/checkpoints/
scripts/finetune_*/outputs/
scripts/finetune_*/runs/

# Final Tests (frozen evaluation bundle): keep code + result summaries only
Final Tests/Datasets/*
!Final Tests/Datasets/.gitkeep
Final Tests/results/**/predictions_*.csv
!Final Tests/results/all_summary.csv
!Final Tests/results/pivot_*.csv
!Final Tests/results/*/summary_*.csv
